# SurgReady AI - FastAPI Backend Environment Configuration
# Stored securely on server-side only

PROJECT_NAME="SurgReady AI Backend"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# CORS Configuration allowing the React frontend (running on port 5173)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Hospital JWT Authentication Settings (Secure Server-Side Configuration)
JWT_SECRET_KEY="your-jwt-secret-key-here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# SNS AI Agent Workbench - Document Analysis Webhook
SNS_WORKBENCH_WEBHOOK_URL="https://api.agents.snsihub.ai/webhook/your-analysis-webhook-id"
SNS_WORKBENCH_HTTP_METHOD="POST"
SNS_WORKBENCH_TIMEOUT_SECONDS=60
SNS_WORKBENCH_AUTH_HEADER_NAME="Authorization"
SNS_WORKBENCH_AUTH_TOKEN=""
SNS_WORKBENCH_PAYLOAD_MODE="json"

# SNS AI Agent Workbench - Authentication Event Webhook (Sign In / Sign Up)
SNS_AUTH_WEBHOOK_URL="https://api.agents.snsihub.ai/webhook/16b2d43d-5b9e-4956-b72f-f51e5cba00d8"
SNS_AUTH_WEBHOOK_TIMEOUT_SECONDS=15.0

# File Upload Settings
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=25
